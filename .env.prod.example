# =============================================================================
# CareerForge-AI Production Environment Variables Template
# =============================================================================
# Copy this file to .env.prod and populate with actual production credentials.
# NEVER commit .env.prod or real secrets into version control.

NODE_ENV=production
PORT=4000
AI_SERVICE_PORT=8000
WEB_PORT=3000

API_BASE_URL=https://api.yourdomain.com
AI_SERVICE_URL=http://ai-service:8000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Relational Database
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/careerforge?schema=public&sslmode=require
POSTGRES_PORT=5432

# Redis Cache & Distributed Rate Limiting
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379
REDIS_PORT=6379

# Kafka Event Backbone
KAFKA_BROKERS=kafka1:9092,kafka2:9092
KAFKA_CLIENT_ID=careerforge-api-prod

# JWT Authentication Secrets (Must be min 32 random characters in production)
JWT_ACCESS_SECRET=replace_with_min_32_char_cryptographically_secure_random_string
JWT_REFRESH_SECRET=replace_with_min_32_char_cryptographically_secure_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

AUTH_COOKIE_NAME=careerforge_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Upload and Security Configuration
MAX_RESUME_SIZE_MB=5
RESUME_STORAGE_DIR=/var/careerforge/storage/uploads/resumes
CORS_ORIGIN=https://yourdomain.com
LOG_LEVEL=info

# AI & LLM Integration (Phase 2 & Phase 3)
LLM_PROVIDER=gemini # options: gemini, openai, mock
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=fastembed # options: fastembed, mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
