# ==============================================================================
# CareerForge AI — Environment Configuration Template
# Copy to .env for local development
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
AI_SERVICE_PORT=8000
WEB_PORT=3000

# Base URLs
API_BASE_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerforge?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerforge
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Apache Kafka (KRaft Mode)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=careerforge-api

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# LLM / AI Service Configuration
LLM_PROVIDER=mock # options: mock, openai, anthropic, ollama, gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# CORS
CORS_ORIGIN=http://localhost:3000

# Observability & Logging
LOG_LEVEL=debug
