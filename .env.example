# CareerForge AI — Environment Configuration Template
# Copy to .env for local development

# Application Environment
NODE_ENV=development
PORT=4000
AI_SERVICE_PORT=8000
WEB_PORT=3000

# Base URLs
API_BASE_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerforge?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerforge
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Apache Kafka (KRaft Mode)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=careerforge-api

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# LLM / AI Service Configuration
PRIMARY_LLM_PROVIDER=gemini # options: gemini, openrouter, openai, mock
FALLBACK_LLM_PROVIDER=openrouter # options: openrouter, gemini, openai, mock
LLM_PROVIDER=gemini # backward compatibility

# Google Gemini (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Optional Secondary
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
FAISS_STORAGE_PATH=./apps/ai-service/storage/faiss

# CORS
CORS_ORIGIN=http://localhost:3000

# Observability & Logging
LOG_LEVEL=debug

# LangSmith Observability & AI Tracing (Phase 8)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerforge-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLE_RATE=1.0
